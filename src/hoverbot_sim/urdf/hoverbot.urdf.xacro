<?xml version="1.0"?>
<!--
  Модель тележки на шасси гироскутера для Gazebo Sim.

  Все размеры — в блоке параметров ниже. Значения оценены по фото и
  помечены TODO там, где нужен точный замер.

  Система координат base_link: начало — середина оси колёс (на высоте оси),
  X — вперёд, Y — влево, Z — вверх. Кадры совпадают с реальным роботом:
  odom → base_link → laser.
-->
<robot name="hoverbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== ПАРАМЕТРЫ (метры, кг) ===================== -->
  <!-- Колёса гироскутера 6.5" -->
  <xacro:property name="wheel_radius"     value="0.08"/>    <!-- замер: Ø 16 см -->
  <xacro:property name="wheel_width"      value="0.06"/>    <!-- замер: (60 − 48) / 2 -->
  <xacro:property name="wheel_separation" value="0.54"/>    <!-- замер: по центрам шин (60 снаружи + 48 изнутри) / 2 -->
  <xacro:property name="wheel_mass"       value="2.5"/>     <!-- мотор-колесо тяжёлое -->

  <!-- Корпуса гироскутера (алюминиевые коробки возле колёс) -->
  <xacro:property name="housing_length"   value="0.20"/>
  <xacro:property name="housing_width"    value="0.15"/>
  <xacro:property name="housing_height"   value="0.06"/>
  <xacro:property name="housing_mass"     value="3.0"/>     <!-- каждый, вместе с платой/аккум. -->

  <!-- Деревянная площадка: лежит на гироскутере и уходит вперёд, к кастеру.
       Назад за колёса не выступает. -->
  <xacro:property name="deck_length"      value="0.50"/>    <!-- замер: вдоль X -->
  <xacro:property name="deck_width"       value="0.30"/>    <!-- замер: вдоль Y -->
  <xacro:property name="deck_thickness"   value="0.02"/>
  <xacro:property name="deck_rear_x"      value="-0.08"/>   <!-- задний край площадки от оси (по фото) -->
  <xacro:property name="deck_bottom_z"    value="0.04"/>    <!-- TODO: низ площадки над осью колёс -->
  <xacro:property name="deck_mass"        value="2.0"/>

  <!-- Поворотное колесо (кастер) спереди, под передним краем площадки -->
  <xacro:property name="caster_radius"    value="0.03"/>    <!-- TODO: радиус колёсика кастера -->
  <xacro:property name="caster_x"         value="0.37"/>    <!-- TODO: от оси колёс до оси кастера -->

  <!-- Короб под лидар (3D-печать) -->
  <xacro:property name="box_length"       value="0.20"/>
  <xacro:property name="box_width"        value="0.14"/>
  <xacro:property name="box_height"       value="0.09"/>

  <!-- Лидар от пылесоса: центр вращения и высота плоскости луча -->
  <xacro:property name="lidar_x"          value="0.10"/>    <!-- замер: 10 см от оси колёс вперёд -->
  <xacro:property name="lidar_y"          value="0.0"/>
  <xacro:property name="lidar_height"     value="0.25"/>    <!-- замер: от пола до лидара -->
  <xacro:property name="lidar_rate"       value="5"/>       <!-- об/с -->
  <xacro:property name="lidar_samples"    value="360"/>
  <xacro:property name="lidar_range_min"  value="0.15"/>
  <xacro:property name="lidar_range_max"  value="8.0"/>
  <xacro:property name="lidar_noise"      value="0.01"/>    <!-- СКО дальности, м -->

  <!-- Производные величины -->
  <xacro:property name="deck_center_x" value="${deck_rear_x + deck_length / 2}"/>
  <xacro:property name="deck_top_z"    value="${deck_bottom_z + deck_thickness}"/>
  <xacro:property name="lidar_z"       value="${lidar_height - wheel_radius}"/>
  <xacro:property name="caster_z"      value="${caster_radius - wheel_radius}"/>

  <!-- ===================== МАКРОСЫ ИНЕРЦИИ ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12}" iyz="0"
               izz="${m * (x*x + y*y) / 12}"/>
    </inertial>
  </xacro:macro>

  <material name="wood">  <color rgba="0.85 0.70 0.50 1"/></material>
  <material name="alu">   <color rgba="0.70 0.70 0.72 1"/></material>
  <material name="rubber"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="plastic"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="red">   <color rgba="0.90 0.25 0.25 1"/></material>

  <!-- ===================== КОРПУС ===================== -->
  <link name="base_link">
    <!-- корпуса гироскутера -->
    <xacro:macro name="housing" params="side">
      <visual>
        <origin xyz="0 ${side * (wheel_separation / 2 - wheel_width / 2 - housing_width / 2)} 0"/>
        <geometry><box size="${housing_length} ${housing_width} ${housing_height}"/></geometry>
        <material name="alu"/>
      </visual>
      <collision>
        <origin xyz="0 ${side * (wheel_separation / 2 - wheel_width / 2 - housing_width / 2)} 0"/>
        <geometry><box size="${housing_length} ${housing_width} ${housing_height}"/></geometry>
      </collision>
    </xacro:macro>
    <xacro:housing side="1"/>
    <xacro:housing side="-1"/>

    <!-- деревянная площадка -->
    <visual>
      <origin xyz="${deck_center_x} 0 ${deck_bottom_z + deck_thickness / 2}"/>
      <geometry><box size="${deck_length} ${deck_width} ${deck_thickness}"/></geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="${deck_center_x} 0 ${deck_bottom_z + deck_thickness / 2}"/>
      <geometry><box size="${deck_length} ${deck_width} ${deck_thickness}"/></geometry>
    </collision>

    <!-- короб под лидар -->
    <visual>
      <origin xyz="${lidar_x} ${lidar_y} ${deck_top_z + box_height / 2}"/>
      <geometry><box size="${box_length} ${box_width} ${box_height}"/></geometry>
      <material name="plastic"/>
    </visual>
    <collision>
      <origin xyz="${lidar_x} ${lidar_y} ${deck_top_z + box_height / 2}"/>
      <geometry><box size="${box_length} ${box_width} ${box_height}"/></geometry>
    </collision>

    <!-- масса: корпуса + площадка, центр масс примерно у оси -->
    <xacro:box_inertia m="${2 * housing_mass + deck_mass}"
                       x="${deck_length}" y="${wheel_separation}" z="0.1"/>
  </link>

  <!-- ===================== КОЛЁСА ===================== -->
  <xacro:macro name="wheel" params="name side">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass * wheel_radius * wheel_radius / 2}" iyz="0"
                 izz="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${side * wheel_separation / 2} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel name="left"  side="1"/>
  <xacro:wheel name="right" side="-1"/>

  <!-- ===================== ПОВОРОТНОЕ КОЛЕСО (КАСТЕР) ===================== -->
  <link name="caster">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="plastic"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="4e-5"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${caster_x} 0 ${caster_z}"/>
  </joint>
  <gazebo reference="caster">
    <!-- без трения: шар имитирует свободно поворачивающийся кастер -->
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ===================== ЛИДАР ===================== -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 -0.01"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}"/>
  </joint>

  <gazebo reference="laser">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>laser</gz_frame_id>
      <update_rate>${lidar_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2 * pi / lidar_samples}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_range_min}</min>
          <max>${lidar_range_max}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_noise}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== IMU (MPU6050) ===================== -->
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- ===================== ПЛАГИНЫ ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
