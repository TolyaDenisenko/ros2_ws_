<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hoverbot_nav</name>
  <version>0.1.0</version>
  <description>Nav2 (costmap, планировщик, контроллер) и octomap для тележки; общий для симуляции и реального робота</description>
  <maintainer email="anatoly@quasi.ai">TolyaDenisenko</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>laser_geometry</depend>

  <exec_depend>esp32_bridge</exec_depend>
  <exec_depend>hoverbot_sim</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>octomap_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
